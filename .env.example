# ── Sitio ────────────────────────────────────────────────────────────────
# Provisional hasta que se defina el dominio de producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Analítica ────────────────────────────────────────────────────────────
# Vacío en desarrollo: sin este valor no se carga GA4 y los eventos
# se registran solo en consola.
NEXT_PUBLIC_GA_ID=

# ── Contacto ─────────────────────────────────────────────────────────────
# Número en formato internacional sin signos: 51 + número.
NEXT_PUBLIC_WHATSAPP_NUMERO=51999999999

# ── Sanity ───────────────────────────────────────────────────────────────
# Sin PROJECT_ID válido el sitio arranca igual, con contenido vacío.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
SANITY_API_READ_TOKEN=
# Solo para el script de semilla (scripts/sembrar-sanity.mjs).
SANITY_API_WRITE_TOKEN=

# ── Correo ───────────────────────────────────────────────────────────────
# Sin RESEND_API_KEY los formularios validan y responden bien,
# pero el envío queda registrado en consola en vez de enviarse.
RESEND_API_KEY=
CORREO_NOTIFICACIONES=hola@arietanoova.pe
CORREO_REMITENTE=Arieta Noova <onboarding@resend.dev>
